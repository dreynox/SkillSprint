# SkillSprint – Environment Variable Reference
# Copy this file to .env and fill in your values.
# Never commit the populated .env file.

# ── Authentication ─────────────────────────────────────────────────────────────
SECRET_KEY=change-me-in-production
ALGORITHM=HS256

# ── Database ───────────────────────────────────────────────────────────────────
# Leave unset to use the bundled SQLite file (development only).
# DATABASE_URL=postgresql+psycopg2://user:password@host:5432/skillsprint

# ── SMTP / Email ───────────────────────────────────────────────────────────────
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=no-reply@example.com
SMTP_PASSWORD=your-smtp-password
SMTP_FROM_EMAIL=no-reply@example.com
SMTP_USE_TLS=true

# ── OTP ────────────────────────────────────────────────────────────────────────
OTP_EXPIRY_MINUTES=5
OTP_MAX_ATTEMPTS=5

# ── Compiler / Sandbox ─────────────────────────────────────────────────────────
#
# COMPILER_SANDBOX_ENABLED
#   Set to true on any host that has Docker available and the socket mounted
#   (/var/run/docker.sock).  When false (the default), code runs directly in
#   the API process — safe only for local development.
COMPILER_SANDBOX_ENABLED=false

# COMPILER_SANDBOX_IMAGE
#   Docker image used as the ephemeral execution sandbox.
#   Build from the project root:
#     docker build -t skillsprint-sandbox:latest .
COMPILER_SANDBOX_IMAGE=skillsprint-sandbox:latest

# COMPILER_CPU_LIMIT
#   Fractional CPUs allocated to each execution container.
#   0.5 = half a CPU core per submission.
COMPILER_CPU_LIMIT=0.5

# COMPILER_MEM_LIMIT
#   Maximum memory per execution container (Docker memory string).
#   Swap is disabled (--memory-swap set to the same value).
COMPILER_MEM_LIMIT=256m

# COMPILER_PID_LIMIT
#   Maximum number of processes (PIDs) inside the container.
#   Prevents fork bombs.  64 is sufficient for all supported languages.
COMPILER_PID_LIMIT=64

# COMPILER_TIMEOUT_SECONDS
#   Hard wall-clock timeout in seconds.  The container is force-killed after
#   this limit regardless of the timeout value the client requests.
COMPILER_TIMEOUT_SECONDS=10

# COMPILER_NETWORK_MODE
#   Docker network mode for execution containers.
#   "none" = no network access from submitted code (strongly recommended).
#   Set to "bridge" only if a language runtime genuinely requires internet
#   access during execution (not recommended).
COMPILER_NETWORK_MODE=none
